# ---------------------------------------------------------------------------
# server/.env  --  settings and secrets for the backend
#
# HOW TO USE: copy this file to ".env" (same folder) and fill in the blanks.
# The real ".env" is git-ignored and must NEVER be shared or committed.
# If anything here is missing or wrong, the server refuses to start and tells
# you exactly which line to fix.
# ---------------------------------------------------------------------------


# --- Basics ----------------------------------------------------------------

# Which port the backend listens on. The dashboard talks to it here.
# NOTE: 4100, not 4000 - the DataBUI invitation platform next door uses 4000,
# and both need to run at the same time for RSVPs to flow in.
PORT=4100

# "development" while you build, "production" on a real server.
# Production turns on: Secure "__Host-" cookies, HSTS, proxy trust, and startup
# guards that REFUSE insecure settings (e.g. DASHBOARD_ORIGIN=*).
NODE_ENV=development


# --- Login security --------------------------------------------------------

# The secret used to sign login cookies. Anyone who knows this can forge a
# login, so treat it like a password. At least 32 random characters.
# Generate one with:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts before you have to sign in again (5m .. 30d).
# Shorter = less damage from a stolen cookie. Examples: 30m, 12h, 7d
JWT_EXPIRES_IN=12h


# --- Who is allowed to talk to this server ---------------------------------

# The address(es) of YOUR dashboard (the React app in ../client). Only these
# origins may call the admin/client API with the login cookie, and every
# state-changing request must come from one of them (CSRF protection).
# Comma-separated, no trailing slashes. This side is CREDENTIALED:
#   - "*" works in development only - production REFUSES to start with it
#   - production origins must be https:// (http is allowed only for localhost)
#   - a wildcard "https://*.inviteme.ge" lets EVERY subdomain act as the admin
# Examples:
#   DASHBOARD_ORIGIN=https://dashboard.inviteme.ge
#   DASHBOARD_ORIGIN=https://inviteme-client.onrender.com,http://localhost:5273
# NOTE: 5273, not 5173 - DataBUI's invitation site uses 5173.
DASHBOARD_ORIGIN=http://localhost:5273

# The address(es) of your INVITATION SITE(S) - the pages that send RSVPs in.
# Comma-separated, no trailing slashes. These may ONLY reach /api/intake/*,
# never the admin pages, and never with your login cookie attached.
# Each entry is an exact origin OR a wildcard subdomain "https://*.domain".
# Since intake is cookie-less, a wildcard here is safe. Examples:
#   INTAKE_ALLOWED_ORIGINS=https://*.inviteme.ge          (all subdomains)
#   INTAKE_ALLOWED_ORIGINS=https://invites.inviteme.ge,https://www.inviteme.ge
INTAKE_ALLOWED_ORIGINS=http://localhost:5173


# --- The one admin account -------------------------------------------------

# Used ONLY by "npm run seed" to create / reset your single admin login. The
# RUNNING server does not need these - leave them OUT of your production host's
# environment so the admin's plaintext password isn't sitting there.
# Password rules: 10+ characters, at most 72 bytes, not a common password, and
# must not contain the username. Resetting it signs out every admin session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


# --- MongoDB Atlas: where all data lives -----------------------------------

# Your Atlas connection string. In Atlas: Connect -> Drivers -> copy the string,
# then replace <db_password> with your database user's real password.
# It looks like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Keep this SECRET - it grants full read/write to your data. Never commit it.
MONGODB_URI=

# The database name inside the cluster. Created automatically on first write.
MONGODB_DB=inviteme


# --- Legacy JSON store (migration only) ------------------------------------

# The old single-file store. The running server no longer uses it; it is read
# ONLY by "npm run migrate:mongo" to import your existing data into Atlas once.
DATA_FILE=./data/db.json


# --- Production only: serve the dashboard from this server ------------------

# Leave EMPTY in development (the dashboard runs on its own with "npm run dev").
#
# In production you can point this at the dashboard's built folder so this one
# server serves BOTH the API and the dashboard - one address, which makes login
# cookies and the security policy simplest and safest. To use it:
#   1. cd client && npm run build      (creates client/dist)
#   2. set CLIENT_DIST=../client/dist
#   3. set NODE_ENV=production
# Then everything is at http://localhost:4100 - no separate dashboard server.
CLIENT_DIST=


# --- Optional hardening -----------------------------------------------------

# Login cookie SameSite. Default: "none" in production (dashboard on a different
# site than the API - e.g. two onrender.com apps), "lax" in development.
# Cross-site cookies are blocked by Safari. Best setup: put the dashboard and
# API on the SAME site (app.inviteme.ge + api.inviteme.ge) and set this to lax.
COOKIE_SAMESITE=

# How many reverse proxies sit in front of the server. Default: 1 in production
# or on Render, 0 otherwise. Must be right for the per-IP rate limits to work.
TRUST_PROXY=

# Cloudflare Turnstile secret key. When set, every RSVP must include a valid
# "captchaToken" from the Turnstile widget on your invitation site.
TURNSTILE_SECRET=

# Most answers one event may store - stops a leaked token filling the database.
MAX_ANSWERS_PER_EVENT=2000
